<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title><%= message.subject %></title>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700..800&family=Inter:wght@400;600&display=swap" rel="stylesheet">
    <style>
      body { margin: 0; padding: 0; background: #fff5fa; }
      .content h1 { margin: 0 0 18px; font-family: 'Bricolage Grotesque', 'Inter', Helvetica, Arial, sans-serif; font-size: 30px; line-height: 1.1; font-weight: 800; letter-spacing: -0.02em; color: #2a1250; }
      .content p { margin: 0 0 18px; }
      .content a { color: #7b2ff7; }
      .content strong { color: #2a1250; }
      .content blockquote { margin: 0 0 18px; padding: 14px 18px; border-left: 4px solid #ff5fa8; border-radius: 0 14px 14px 0; background: #fff8d6; color: #2a1250; }
      .content table { width: 100%; margin: 4px 0 18px; border-collapse: collapse; }
      .content th, .content td { padding: 12px 0; border-bottom: 2px dashed #ecdff5; text-align: left; vertical-align: top; }
      .content th { width: 35%; padding-right: 16px; font-weight: 600; color: #2a1250; }
      .content td { white-space: pre-wrap; }
      .content .button { display: inline-block; padding: 13px 26px; border-radius: 999px; border-bottom: 4px solid #4b1a9e; background: #7b2ff7; color: #ffffff; font-weight: 600; text-decoration: none; }
      .content .note { margin-top: 26px; padding-top: 18px; border-top: 2px dashed #ecdff5; font-size: 13px; line-height: 1.6; color: #6b5a86; }
      .content tr:last-child th, .content tr:last-child td { border-bottom: 0; }
      .content > :last-child { margin-bottom: 0; }
      @media (max-width: 480px) { .content { padding: 28px 22px !important; } }
    </style>
  </head>

  <body style="margin: 0; padding: 0; background: #fff5fa;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #fff5fa;">
      <tr>
        <td align="center" style="padding: 36px 16px 44px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px;">
            <tr>
              <td style="padding: 0 6px 18px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="font-family: 'Bricolage Grotesque', 'Inter', Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; color: #2a1250;">
                      <%= site_name %>
                    </td>
                    <td align="right" style="font-size: 0; line-height: 0;">
                      <span style="display: inline-block; width: 18px; height: 6px; margin-left: 6px; border-radius: 6px; background: #ff5fa8;"></span>
                      <span style="display: inline-block; width: 10px; height: 10px; margin-left: 6px; border-radius: 4px; background: #ffd93d;"></span>
                      <span style="display: inline-block; width: 18px; height: 6px; margin-left: 6px; border-radius: 6px; background: #4f5bff;"></span>
                      <span style="display: inline-block; width: 8px; height: 8px; margin-left: 6px; border-radius: 8px; background: #7b2ff7;"></span>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td class="content" style="padding: 36px 34px; background: #ffffff; border: 2px solid #2a1250; border-radius: 28px; box-shadow: 6px 6px 0 #ff5fa8; font-family: 'Inter', Helvetica, Arial, sans-serif; font-size: 15px; line-height: 1.65; color: #4a3b63;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding: 22px 6px 0; font-family: 'Inter', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 1.6; color: #8a79a3;">
                Sent with a lot of snacks from <a href="https://nibble.ink" style="color: #7b2ff7; font-weight: 600; text-decoration: none;">nibble.ink</a>.
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
