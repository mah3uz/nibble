# Kamal deploy for <%= host %>.   Usage: bin/kamal deploy
# Staging overlay: config/deploy.staging.yml (bin/kamal deploy -d staging).
# Secrets come from .kamal/secrets (production) and .kamal/secrets.staging.

service: <%= name %>

image: <%= registry_user %>/<%= name %>

# SQLite: one web server per environment, with the storage volume below.
servers:
  web:
    - <%= server %>

proxy:
  ssl: true
  hosts:
    - <%= host %>

registry:
  username: <%= registry_user %>
  # Always use an access token rather than a real password.
  password:
    - KAMAL_REGISTRY_PASSWORD

# App secrets (smtp, aws, nibble.secrets) live in the Rails credentials.
env:
  secret:
    - RAILS_MASTER_KEY
  clear:
    # Public site URL (canonicals, sitemaps, robots and mail links)
    SITE_URL: <%= url %>

    # Outgoing mail (smtp username/password live in the Rails credentials)
    SMTP_ADDRESS: smtp.postmarkapp.com
    SMTP_PORT: 587

    # Run the Solid Queue Supervisor inside Puma (scheduled publishing).
    SOLID_QUEUE_IN_PUMA: true

    # Nightly compacted database backup (DatabaseSnapshotJob). Unset means no offsite backup.
    # DB_SNAPSHOT_BUCKET: <%= name %>-backups
    # DB_SNAPSHOT_REGION: ap-southeast-2

aliases:
  console: app exec --interactive --reuse "bin/rails console"
  shell: app exec --interactive --reuse "bash"
  logs: app logs -f
  dbc: app exec --interactive --reuse "bin/rails dbconsole"

ssh:
  user: <%= ssh_user %>

# Persistent storage for the SQLite databases and local Active Storage files.
volumes:
  - <%= name %>-storage:/rails/storage

# Bridge fingerprinted Vite assets between versions to avoid 404s on in-flight requests.
asset_path: /rails/public/vite

builder:
  arch: amd64
