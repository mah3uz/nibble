<p>Hi <%= @user.name %>,</p>
<p>
  You've been given <%= @user.roles.map(&:title).to_sentence.presence || "limited" %> access to <%= site_name %>. Choose your password on
  <%= link_to "this page", edit_password_url(@user.generate_token_for(:invitation)) %>, then sign in with
  <%= @user.email_address %>.
</p>
<p>This link will expire in <%= distance_of_time_in_words(0, User::INVITATION_EXPIRES_IN) %> and works once.</p>
