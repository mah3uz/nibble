{
  "name": "nibble-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "NIBBLE_THEME=crumbs bin/rails nibble:schema:types --without-site --output tmp/nibble/crumbs-types.d.ts > /dev/null && vue-tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern vendor/nibble/frontend vendor/nibble/themes site/themes",
    "format:check": "prettier --check --no-error-on-unmatched-pattern vendor/nibble/frontend vendor/nibble/themes site/themes",
    "test:js": "vitest run --root vendor/nibble/frontend"
  },
  "workspaces": [
    "vendor/nibble",
    "vendor/nibble/themes/*"
  ],
  "devDependencies": {
    "vite-plugin-vue-devtools": "^8.2.1"
  }
}
