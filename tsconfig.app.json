{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Aliases */
    "paths": {
      "@/*": ["./lib/nibble/frontend/nibble-admin/*"],
      "~/*": ["./lib/nibble/frontend/nibble-admin/*"],
      "@nibble-admin/*": ["./lib/nibble/frontend/nibble-admin/*"],
      "@nibble": ["./lib/nibble/frontend/nibble/index.ts"],
      "@nibble/*": ["./lib/nibble/frontend/nibble/*"],
      "@theme/*": ["./themes/crumbs/*"]
    }
  },

  "include": [
    "lib/nibble/frontend/**/*.ts",
    "lib/nibble/frontend/**/*.tsx",
    "lib/nibble/frontend/**/*.vue",
    "themes/*/**/*.ts",
    "themes/*/**/*.vue",
    "themes/*/.nibble/*.d.ts"
  ]
}
