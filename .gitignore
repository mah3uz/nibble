# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore all environment files. Nibble ships none: the install generates yours.
/.env*

# Deploy configuration carries your hosts, registry and domains. The install generates it.
/config/deploy.yml
/config/deploy.staging.yml

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

# A site's own encrypted credentials. Nibble ships none: an install generates its own, and keeping
# someone else's ciphertext in the repo means a leaked key exposes every version of it.
/config/credentials/*.yml.enc
/config/credentials.yml.enc

# Working notes, plans and research. Kept out of the repository so what ships is the product,
# not the story of how it got here. Back these up separately — they are not versioned here.
/.claude/

# Vite / Node
/node_modules
/public/vite*
/public/assets
/public/ssr
.vite

# Playwright test artifacts
/playwright*
/.playwright*

# End-to-end test dependencies
/test/e2e/node_modules
.idea

# Vite uses dotenv and suggests to ignore local-only env files. See
# https://vitejs.dev/guide/env-and-mode.html#env-files
*.local

