<h1><%= @visitor ? "Your submission" : "New submission" %></h1>
<% if @message %>
  <%= simple_format(h(@message), {}, sanitize: false) %>
<% elsif @visitor %>
  <p>Thanks for filling in <strong><%= @form.title(@locale) || @form.handle %></strong> on <%= site_name %>. Here's what you sent.</p>
<% else %>
  <p>Someone filled in <strong><%= @form.title(@locale) || @form.handle %></strong> on <%= site_name %>. Here's what they sent.</p>
<% end %>
<table role="presentation" cellpadding="0" cellspacing="0">
  <% @rows.each do |label, value| %>
    <tr>
      <th><%= label %></th>
      <td><%= value.presence || "—" %></td>
    </tr>
  <% end %>
</table>
<% if @reply_to %>
  <p class="note">Reply to this email to answer them at <%= @reply_to %>.</p>
<% end %>
<% if @link %>
  <p class="note"><%= link_to "Open this submission in the Control Plane", @link %></p>
<% end %>
