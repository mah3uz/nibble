<h1><%= NotificationsMailer::SUBJECTS.fetch(@notification.kind, "Something needs your attention") %></h1>
<p><strong><%= @title || "A record" %></strong> on <%= site_name %>.</p>
<% if @comment.present? %>
  <blockquote><%= @comment %></blockquote>
<% end %>
<p><%= link_to "Open your notifications", admin_notifications_url, class: "button" %></p>
