#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  system("npm ci") || system!("npm install")

  puts "\n== Site folders =="
  # site/ is the site's own and may not be in git, so a fresh clone gets the folders Nibble reads.
  templates = File.join(APP_ROOT, "vendor/nibble/templates/site")
  Dir.glob("**/*", File::FNM_DOTMATCH, base: templates).sort.each do |relative|
    source = File.join(templates, relative)
    target = File.join(APP_ROOT, "site", relative)
    next unless File.file?(source) && !File.exist?(target)

    FileUtils.mkdir_p(File.dirname(target))
    FileUtils.cp(source, target)
    puts "created site/#{relative}"
  end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Generated types =="
  system! "bin/rails nibble:build"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Signing in =="
  system! "bin/rails", "runner", <<~RUBY
    puts Nibble::User.administrators.exists? ? "an administrator exists" : "no administrator yet; create one with: bin/rails nibble:admin:create"
  RUBY

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
