#!/usr/bin/env ruby
require "pathname"

ROOT = Pathname(__dir__).parent
VERSION_FILE = ROOT.join("lib/nibble.rb")
CHANGELOG = ROOT.join("CHANGELOG.md")

def fail!(message) = abort("release refused: #{message}")

version = ARGV.first or fail!("usage: bin/nibble-release <version>, e.g. bin/nibble-release 0.2.0")
fail!("#{version} isn't a version like 1.2.3") unless version.match?(/\A\d+\.\d+\.\d+\z/)

current = VERSION_FILE.read[/VERSION = "([^"]+)"/, 1]
current_tagged = !`git -C #{ROOT} tag -l v#{current}`.strip.empty?
if current_tagged
  fail!("#{version} isn't newer than #{current}") unless Gem::Version.new(version) > Gem::Version.new(current)
elsif Gem::Version.new(version) < Gem::Version.new(current)
  fail!("#{version} is behind #{current}, which has no tag yet")
end
fail!("working tree isn't clean") unless `git -C #{ROOT} status --porcelain`.strip.empty?

notes = CHANGELOG.read[/^## Unreleased\n(.*?)(?=^## |\z)/m, 1].to_s.strip
fail!("CHANGELOG.md has nothing under Unreleased") if notes.empty?

VERSION_FILE.write(VERSION_FILE.read.sub(/VERSION = "[^"]+"/, %(VERSION = "#{version}")))
CHANGELOG.write(CHANGELOG.read.sub(/^## Unreleased\n/, "## Unreleased\n\n## #{version} — #{Time.now.strftime('%Y-%m-%d')}\n"))

puts "running bin/ci"
system(ROOT.join("bin/ci").to_s) or fail!("bin/ci failed — nothing was committed or tagged")

system("git", "-C", ROOT.to_s, "add", VERSION_FILE.to_s, CHANGELOG.to_s) or fail!("could not stage the release")
system("git", "-C", ROOT.to_s, "commit", "-qm", "Release #{version}") or fail!("could not commit the release")
system("git", "-C", ROOT.to_s, "tag", "-a", "v#{version}", "--cleanup=verbatim", "-m", "Nibble #{version}\n\n#{notes}") or fail!("could not tag the release")

repository = VERSION_FILE.read[/REPOSITORY = "([^"]+)"/, 1]
puts "tagged v#{version}. Push it with: git push #{repository} main --follow-tags"
