#!/usr/bin/env ruby
require "fileutils"
require "optparse"
require "pathname"
require_relative "../lib/release_archive"

ROOT = Pathname(__dir__).parent
VERSION_FILE = ROOT.join("vendor/nibble/lib/nibble.rb")
LOCKFILE = ROOT.join("Gemfile.lock")
CHANGELOG = ROOT.join("CHANGELOG.md")
SETTINGS = ROOT.join("config/nibble.yml")
PACKED = ROOT.join("tmp/release")
def fail!(message) = abort("release refused: #{message}")

# A tag nobody can fetch is not a release, so the last step is offered rather than left as a note.
def confirm?(question, assumed)
  return true if assumed
  return false unless $stdin.tty?

  print "#{question} [y/N] "
  $stdin.gets.to_s.strip.casecmp?("y")
end

push = false
pack_only = false
parser = OptionParser.new do |opts|
  opts.banner = "usage: bin/nibble-release <version> [--push] [--pack], e.g. bin/nibble-release 0.2.0"
  opts.on("--pack", "Only pack and publish a release already tagged here, e.g. after the upload failed") { pack_only = true }
  opts.on("--push", "Push without asking") { push = true }
end
parser.parse!

version = ARGV.first or fail!(parser.help)
fail!("#{version} isn't a version like 1.2.3") unless version.match?(/\A\d+\.\d+\.\d+\z/)
repository = VERSION_FILE.read[/REPOSITORY = "([^"]+)"/, 1]

# The archive is what a site installs, so it is packed from the tagged tree and published beside the tag.
def publish(version, notes, repository, assumed)
  fail!("working tree isn't clean") unless `git -C #{ROOT} status --porcelain`.strip.empty?
  fail!("HEAD isn't v#{version}") unless `git -C #{ROOT} tag --points-at HEAD`.split.include?("v#{version}")

  FileUtils.rm_rf(PACKED)
  built = ReleaseArchive.new(root: ROOT, out: PACKED).build
  fail!("packed #{built.version}, not #{version}") unless built.version == version
  puts "packed #{built.archive.relative_path_from(ROOT)} (sha256 #{built.sha256})"

  slug = repository[%r{github\.com[/:](.+?)(?:\.git)?\z}, 1]
  command = [ "gh", "release", "create", "v#{version}", built.archive.to_s, built.sums.to_s, "--repo", slug,
              "--title", "Nibble #{version}", "--notes", notes, "--verify-tag" ]
  if confirm?("publish v#{version} on GitHub with its archive?", assumed)
    system(*command) or warn "could not publish the release — once v#{version} is pushed: bin/nibble-release #{version} --pack"
  else
    puts "not published. Once v#{version} is pushed: bin/nibble-release #{version} --pack"
  end
end

if pack_only
  notes = IO.popen([ "git", "-C", ROOT.to_s, "tag", "-l", "--format=%(contents:body)", "v#{version}" ], &:read).strip
  publish(version, notes, repository, push)
  exit
end


current = VERSION_FILE.read[/VERSION = "([^"]+)"/, 1]
current_tagged = !`git -C #{ROOT} tag -l v#{current}`.strip.empty?
if current_tagged
  fail!("#{version} isn't newer than #{current}") unless Gem::Version.new(version) > Gem::Version.new(current)
elsif Gem::Version.new(version) < Gem::Version.new(current)
  fail!("#{version} is behind #{current}, which has no tag yet")
end
fail!("working tree isn't clean") unless `git -C #{ROOT} status --porcelain`.strip.empty?

notes = CHANGELOG.read[/^## Unreleased\n(.*?)(?=^## \d+\.\d+\.\d+ |\z)/m, 1].to_s.strip
fail!("CHANGELOG.md has nothing under Unreleased") if notes.empty?

date = Time.now.strftime("%Y-%m-%d %H:%M %z")
# The tree was clean to begin with, so whatever this writes before giving up has to go back.
undo = { VERSION_FILE => VERSION_FILE.read, CHANGELOG => CHANGELOG.read, LOCKFILE => LOCKFILE.read, SETTINGS => SETTINGS.read }
at_exit { undo.each { |file, content| file.write(content) } }
VERSION_FILE.write(VERSION_FILE.read.sub(/VERSION = "[^"]+"/, %(VERSION = "#{version}")))
CHANGELOG.write(CHANGELOG.read.sub(/^## Unreleased\n/, "## Unreleased\n\n## #{version} — #{date}\n"))
# Nibble's own site runs each release's behaviour from the release that brings it.
fail!("config/nibble.yml has no load_defaults line to raise") unless SETTINGS.read.match?(/^\s*load_defaults:/)
SETTINGS.write(SETTINGS.read.sub(/^(\s*load_defaults:\s*)\S+/) { %(#{$1}"#{version}") })
system("bundle", "lock", chdir: ROOT.to_s, out: File::NULL) or fail!("could not record #{version} in Gemfile.lock")

puts "running bin/ci"
system({ "CI" => "1" }, ROOT.join("bin/ci").to_s) or fail!("bin/ci failed — nothing was committed or tagged")

system("git", "-C", ROOT.to_s, "add", VERSION_FILE.to_s, CHANGELOG.to_s, LOCKFILE.to_s, SETTINGS.to_s) or fail!("could not stage the release")
system("git", "-C", ROOT.to_s, "commit", "-qm", "Release #{version}") or fail!("could not commit the release")
undo.clear
system("git", "-C", ROOT.to_s, "tag", "-a", "v#{version}", "--cleanup=verbatim", "-m", "Nibble #{version}\n\n#{notes}") or fail!("could not tag the release")

puts "tagged v#{version}"

if confirm?("push main and v#{version} to #{repository}?", push)
  if system("git", "-C", ROOT.to_s, "push", repository, "main", "--follow-tags")
    publish(version, notes, repository, push)
  else
    warn "could not push"
  end
else
  puts "not pushed. When ready: git push #{repository} main --follow-tags, then bin/nibble-release #{version} --pack"
end

# nibble.ink serves the feed every Control Plane reads, from a site/ that isn't tracked here.
feed = ROOT.join("site/content/changelogs/releases.json")
unless ROOT.join("site/content").directory?
  puts "no site/content here, so the feed wasn't written: a Control Plane sees #{version} once nibble.ink publishes it"
  exit
end

unless system(ROOT.join("bin/rails").to_s, "runner", "Nibble::Releases.publish(Rails.root.join('CHANGELOG.md'), #{feed.to_s.inspect})")
  abort "could not write the feed to #{feed}"
end
system(ROOT.join("bin/release-pages").to_s) or abort "bin/release-pages failed — the feed is written, its pages are not"
puts "wrote #{feed.relative_path_from(ROOT)} and its pages"

site = ROOT.join("site").to_s
if confirm?("commit #{version}'s notes in site/, and push them if it has a remote?", push)
  committed = system("git", "-C", site, "add", "-A", "--", "content/changelogs") &&
              system("git", "-C", site, "commit", "-qm", "Publish #{version}'s notes", "--", "content/changelogs")
  warn "could not commit the notes — commit them in site/" unless committed
  remote = IO.popen([ "git", "-C", site, "remote" ], err: File::NULL, &:read).strip
  system("git", "-C", site, "push") or warn "could not push site/" if committed && !remote.empty?
else
  puts "not committed. Commit site/content/changelogs in site/, then deploy nibble.ink, and a Control Plane will see #{version}."
end
