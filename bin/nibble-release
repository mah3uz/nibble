#!/usr/bin/env ruby
require "optparse"
require "pathname"

ROOT = Pathname(__dir__).parent
VERSION_FILE = ROOT.join("lib/nibble.rb")
CHANGELOG = ROOT.join("CHANGELOG.md")
def fail!(message) = abort("release refused: #{message}")

# A tag nobody can fetch is not a release, so the last step is offered rather than left as a note.
def confirm?(question, assumed)
  return true if assumed
  return false unless $stdin.tty?

  print "#{question} [y/N] "
  $stdin.gets.to_s.strip.casecmp?("y")
end

feed = nil
push = false
parser = OptionParser.new do |opts|
  opts.banner = "usage: bin/nibble-release <version> [--feed PATH] [--push], e.g. bin/nibble-release 0.2.0"
  opts.on("--feed PATH", "Write the release feed here once tagged, e.g. ../nibble_site/content/docs/releases.json") { |path| feed = path }
  opts.on("--push", "Push without asking") { push = true }
end
parser.parse!

version = ARGV.first or fail!(parser.help)
fail!("#{version} isn't a version like 1.2.3") unless version.match?(/\A\d+\.\d+\.\d+\z/)


current = VERSION_FILE.read[/VERSION = "([^"]+)"/, 1]
current_tagged = !`git -C #{ROOT} tag -l v#{current}`.strip.empty?
if current_tagged
  fail!("#{version} isn't newer than #{current}") unless Gem::Version.new(version) > Gem::Version.new(current)
elsif Gem::Version.new(version) < Gem::Version.new(current)
  fail!("#{version} is behind #{current}, which has no tag yet")
end
fail!("working tree isn't clean") unless `git -C #{ROOT} status --porcelain`.strip.empty?

notes = CHANGELOG.read[/^## Unreleased\n(.*?)(?=^## \d+\.\d+\.\d+ |\z)/m, 1].to_s.strip
fail!("CHANGELOG.md has nothing under Unreleased") if notes.empty?

date = Time.now.strftime("%Y-%m-%d")
VERSION_FILE.write(VERSION_FILE.read.sub(/VERSION = "[^"]+"/, %(VERSION = "#{version}")))
CHANGELOG.write(CHANGELOG.read.sub(/^## Unreleased\n/, "## Unreleased\n\n## #{version} — #{date}\n"))

puts "running bin/ci"
system(ROOT.join("bin/ci").to_s) or fail!("bin/ci failed — nothing was committed or tagged")

system("git", "-C", ROOT.to_s, "add", VERSION_FILE.to_s, CHANGELOG.to_s) or fail!("could not stage the release")
system("git", "-C", ROOT.to_s, "commit", "-qm", "Release #{version}") or fail!("could not commit the release")
system("git", "-C", ROOT.to_s, "tag", "-a", "v#{version}", "--cleanup=verbatim", "-m", "Nibble #{version}\n\n#{notes}") or fail!("could not tag the release")

repository = VERSION_FILE.read[/REPOSITORY = "([^"]+)"/, 1]
puts "tagged v#{version}"

if confirm?("push main and v#{version} to #{repository}?", push)
  system("git", "-C", ROOT.to_s, "push", repository, "main", "--follow-tags") or warn "could not push"
else
  puts "not pushed. When ready: git push #{repository} main --follow-tags"
end

unless feed
  puts "the notes a site reads come from the feed: re-run with --feed <documentation site>/content/docs/releases.json"
  exit
end

unless system(ROOT.join("bin/rails").to_s, "runner",
              "Nibble::Releases.publish(Rails.root.join('CHANGELOG.md'), #{feed.inspect})")
  abort "could not write the feed to #{feed}"
end
puts "wrote #{feed}"

# Its own repository, so only that one file is committed and nothing else there is touched.
site = Pathname(feed).expand_path.dirname
if confirm?("commit and push it in #{site}?", push)
  system("git", "-C", site.to_s, "add", "--", feed) &&
    system("git", "-C", site.to_s, "commit", "-qm", "Publish #{version}'s notes", "--", feed) &&
    system("git", "-C", site.to_s, "push") or warn "could not publish the feed — commit it where it lives"
else
  puts "not published. Commit #{feed} where it lives, and a control panel will see #{version}."
end
