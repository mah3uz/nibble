#!/usr/bin/env ruby
# Packs a release from this checkout and installs it with install.sh into an empty directory, the way someone new
# would, then boots and serves the site: a release that can't make a working site fails here instead.
require "fileutils"
require "tmpdir"
require "yaml"
require_relative "../lib/release_archive"

ROOT = File.expand_path("..", __dir__)
work = Dir.mktmpdir("nibble-install-smoke")
at_exit { FileUtils.rm_rf(work) unless ENV["KEEP"] }
site = File.join(work, "site")

# Nothing inherited from this checkout's own bundle.
ENV.delete_if { |key, _| key.start_with?("BUNDLE_") || %w[RUBYOPT RUBYLIB].include?(key) }

def run!(env, *command, chdir:)
  puts "$ #{command.join(' ')}"
  system(env, *command, chdir:, exception: true)
end

def check(truth, message) = truth || abort("install smoke failed: #{message}")

built = ReleaseArchive.new(root: ROOT, out: File.join(work, "release")).build
run!({ "NIBBLE_ARCHIVE" => built.archive.to_s, "NIBBLE_OFFLINE" => "1" }, File.join(ROOT, "install.sh"), "site", "--defaults",
     chdir: work)

record = YAML.safe_load(File.read(File.join(site, "config/nibble.yml")).partition("# Written by Nibble").last.lines.drop(1).join)
check record.dig("install", "version") == built.version, "the install record names #{record.dig('install', 'version').inspect}"
check record.dig("install", "answers").keys.sort == %w[name theme url], "the install recorded #{record.dig('install', 'answers').inspect}"
check !File.exist?(File.join(site, "Dockerfile")) && !File.exist?(File.join(site, "bin/docker-entrypoint")),
      "deploy files were written for a site that didn't ask for Kamal"
check File.exist?(File.join(site, "site/types.d.ts")), "the install didn't generate site/types.d.ts"
run!({}, "sha256sum", "--quiet", "-c", "MANIFEST", chdir: File.join(site, "vendor/nibble"))

env = { "RAILS_ENV" => "test" }
run!(env, "bin/rails", "db:prepare", chdir: site)
run!(env, "bin/rails", "zeitwerk:check", chdir: site)
run!(env, "bin/rails", "nibble:check", chdir: site)
run!(env, "bin/vite", "build", chdir: site)
run!(env, "bin/vite", "build", "--ssr", chdir: site)
run!(env, "bin/rails", "runner", <<~'RUBY', chdir: site)
  abort "the generated credentials have no secret_key_base, so production would refuse to boot" if Rails.application.credentials.secret_key_base.blank?
  { "/" => [ 200, 404 ], "/admin/session/new" => [ 200 ] }.each do |path, statuses|
    status, _, body = Rails.application.call(Rack::MockRequest.env_for(path, "HTTP_HOST" => "www.example.com"))
    html = +""
    body.each { |chunk| html << chunk }
    abort "#{path} answered #{status}" unless statuses.include?(status)
    abort "#{path} rendered no Inertia page" unless html.include?("data-page") || html.include?("application/json")
  end
RUBY

puts "a release installs, boots and serves"
