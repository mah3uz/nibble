#!/usr/bin/env ruby
# Renders every install template into an empty directory beside a copy of this checkout's vendor/nibble, then boots
# the result, so a template that can't make a working site fails here rather than for someone installing.
require "fileutils"
require "tmpdir"

ROOT = File.expand_path("..", __dir__)
site = Dir.mktmpdir("nibble-install-smoke")
at_exit { FileUtils.rm_rf(site) unless ENV["KEEP"] }

def run!(env, *command, chdir:)
  puts "$ #{command.join(' ')}"
  system(env, *command, chdir:, exception: true)
end

answers = { name: "smoke", url: "https://smoke.example", theme: "crumbs" }
run!({}, "bin/rails", "runner", "Nibble::Install.new(root: #{site.inspect}, answers: #{answers.inspect}).run", chdir: ROOT)

# A copy, not a link: Vite resolves links, and would write the site's build into this checkout.
FileUtils.mkdir_p(File.join(site, "vendor"))
FileUtils.cp_r(File.join(ROOT, "vendor/nibble"), File.join(site, "vendor/nibble"))
File.symlink(File.join(ROOT, "node_modules"), File.join(site, "node_modules"))

# Its own Gemfile, resolved from the gems this checkout already has, and nothing inherited from ours.
env = ENV.keys.grep(/\A(BUNDLE_|RUBYOPT|RUBYLIB)/).to_h { |key| [ key, nil ] }
env.merge!("BUNDLE_GEMFILE" => File.join(site, "Gemfile"), "RAILS_ENV" => "test")
run!(env, "bundle", "install", "--local", "--quiet", chdir: site)
run!(env, "bin/rails", "db:prepare", chdir: site)
run!(env, "bin/rails", "zeitwerk:check", chdir: site)
run!(env, "bin/rails", "nibble:build", chdir: site)
run!(env, "bin/rails", "nibble:check", chdir: site)
run!(env, "bin/vite", "build", chdir: site)
run!(env, "bin/vite", "build", "--ssr", chdir: site)
run!(env, "bin/rails", "runner", <<~'RUBY', chdir: site)
  { "/" => [ 200, 404 ], "/admin/session/new" => [ 200 ] }.each do |path, statuses|
    status, _, body = Rails.application.call(Rack::MockRequest.env_for(path, "HTTP_HOST" => "www.example.com"))
    html = +""
    body.each { |chunk| html << chunk }
    abort "#{path} answered #{status}" unless statuses.include?(status)
    abort "#{path} rendered no Inertia page" unless html.include?("data-page") || html.include?("application/json")
  end
RUBY

puts "a fresh install renders, boots and serves"
