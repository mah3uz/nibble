#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# A site commits its generated settings, so they can't be in the shipped .gitignore. This checkout is
# where Nibble itself is built, and must never commit them — .git/info/exclude is local and ships nowhere.
SITE_FILES = %w[config/nibble.yml config/deploy.yml config/deploy.staging.yml .nibble/
                config/credentials.yml.enc config/credentials/].freeze

def ignore_own_site_files
  exclude = File.join(APP_ROOT, ".git/info/exclude")
  return puts "not a git checkout, nothing to ignore" unless File.exist?(exclude)

  present = File.read(exclude).lines.map(&:strip)
  missing = SITE_FILES.reject { |path| present.include?(path) }
  return puts "already ignored" if missing.empty?

  File.write(exclude, "\n# Generated for this checkout; a site commits its own.\n#{missing.join("\n")}\n", mode: "a")
  puts "ignored here only: #{missing.join(', ')}"
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  system! "npm install"

  puts "\n== Ignoring this checkout's own site files =="
  ignore_own_site_files

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
